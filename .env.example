# Server
NODE_ENV=development
PORT=3000

# PostgreSQL
# Prefer DATABASE_URL in deployed environments. Individual values are used locally.
DATABASE_URL=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=irctc_revamped
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_SSL=false

# Redis
REDIS_URL=redis://127.0.0.1:6379
